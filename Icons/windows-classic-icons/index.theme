# Tema de ícones Windows Classic (ícones do Windows XP)
# Segue a Icon Theme Specification e a Icon Naming Specification do freedesktop.org.
#
# Os ícones são escolhidos um a um. Enquanto um nome não tiver ícone aqui, ele vem
# dos temas em Inherits (Adwaita e, por último, hicolor).
#
# Pastas NxN: PNG com exatamente N x N pixels (Type=Fixed).

[Icon Theme]
Name=Windows Classic
Comment=Windows XP icons for the Windows Classic theme
Comment[pt_BR]=Ícones do Windows XP para o tema Windows Classic
Inherits=Adwaita,hicolor
Example=folder

Directories=16x16/actions,16x16/animations,16x16/apps,16x16/categories,16x16/devices,16x16/emblems,16x16/mimetypes,16x16/places,16x16/status,22x22/actions,22x22/animations,22x22/apps,22x22/categories,22x22/devices,22x22/emblems,22x22/mimetypes,22x22/places,22x22/status,24x24/actions,24x24/animations,24x24/apps,24x24/categories,24x24/devices,24x24/emblems,24x24/mimetypes,24x24/places,24x24/status,32x32/actions,32x32/animations,32x32/apps,32x32/categories,32x32/devices,32x32/emblems,32x32/mimetypes,32x32/places,32x32/status,48x48/actions,48x48/animations,48x48/apps,48x48/categories,48x48/devices,48x48/emblems,48x48/mimetypes,48x48/places,48x48/status

